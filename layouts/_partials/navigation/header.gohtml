{{- $logoSrc := strings.TrimPrefix "/" site.Params.header.logo.image -}}

<header
  class="{{- if site.Params.header.sticky -}}sticky top-0 z-50{{ end }} px-4 py-6">
  <div
    class="border-border bg-card/80 flex items-center rounded-xl border-2 px-6 py-4 shadow-sm backdrop-blur-sm">
    <!-- 桌面端布局 -->
    <div class="hidden w-full items-center md:flex md:min-w-0">
      <!-- 左侧：站点 Logo -->
      <div class="flex items-center">
        {{ if ne site.Params.header.logo.image "" }}
        <a
          href="{{ if and site.Params.header.logo.link (ne site.Params.header.logo.link `/`) }}
              {{ site.Params.header.logo.link | relLangURL }}
            {{ else }}
              {{ site.Home.RelPermalink | relLangURL }}
            {{ end }}"
          class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-full transition-transform duration-200 hover:scale-105"
          aria-label="{{ site.Title }}">
          <img
            src="{{ $logoSrc | relURL }}"
            alt="{{ site.Title }}"
            class="h-full w-full object-cover" />
        </a>
        {{ else }}
        <!-- 默认 Logo：使用站点标题首字母 -->
        <a
          href="{{ site.Home.RelPermalink }}"
          class="bg-primary text-primary-foreground hover:bg-primary/90 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold transition-transform duration-200 hover:scale-105"
          aria-label="{{ site.Title }}">
          {{ substr site.Title 0 1 | upper }}
        </a>
        {{ end }}
      </div>

      <!-- 中间：桌面端导航 -->
      <nav class="mx-8 flex min-w-0 flex-1 items-center justify-center">
        <div class="flex flex-wrap items-center justify-center space-x-2">
          {{ $currentPage := . }} {{ range site.Menus.main }} {{/*
          生成语言感知的URL */}} {{ $menuURL := .URL }} {{ if .PageRef }} {{
          with site.GetPage .PageRef }} {{ $menuURL = .RelPermalink }} {{ else
          }} {{ $menuURL = .URL | relLangURL }} {{ end }} {{ end }} {{ if
          .HasChildren }} {{/* 有子菜单的父项：渲染为下拉菜单 */}} {{ $menuKey
          := .Name | anchorize }}
          <div class="relative">
            <button
              class="nav-link nav-submenu-toggle text-muted-foreground hover:text-primary hover:bg-primary/10 focus:ring-primary/20 relative flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-all duration-300 ease-out hover:-translate-y-0.5 hover:scale-105 focus:ring-2 focus:outline-none"
              data-submenu-id="{{ $menuKey }}"
              aria-expanded="false"
              aria-haspopup="true">
              {{ if .Params.icon }} {{ partial ".*.gohtml" (dict "name"
              .Params.icon "size" "md" "ariaLabel" .Name) }} {{ end }}
              <span>{{ .Name }}</span>
              {{ partial "features/icon.gohtml" (dict "name" "alt-arrow-down" "size" "sm"
              "class" "submenu-chevron transition-transform duration-200") }}
            </button>
            <div
              class="nav-submenu border-border bg-popover/95 absolute top-full left-0 z-50 mt-2 hidden min-w-44 space-y-1.5 rounded-xl border-2 p-1.5 shadow-lg backdrop-blur-sm"
              data-submenu-id="{{ $menuKey }}"
              role="menu">
              {{ range .Children }} {{ $childURL := .URL }} {{ if .PageRef }} {{
              with site.GetPage .PageRef }} {{ $childURL = .RelPermalink }} {{
              else }} {{ $childURL = .URL | relLangURL }} {{ end }} {{ end }} {{
              $isChildActive := eq $currentPage.RelPermalink $childURL }}
              <a
                href="{{ $childURL }}"
                class="nav-link {{ if $isChildActive }}
                        bg-card text-accent-foreground
                      {{ else }}
                        text-muted-foreground hover:text-primary hover:bg-primary/10
                      {{ end }} focus:ring-primary/20 flex items-center gap-2 rounded-lg px-2 py-2 text-sm leading-snug transition-colors duration-200 focus:ring-2 focus:outline-none"
                role="menuitem"
                {{
                if
                $isChildActive
                }}aria-current="page"
                {{
                end
                }}>
                {{ if .Params.icon }} {{ partial ".*.gohtml" (dict "name"
                .Params.icon "size" "sm" "ariaLabel" .Name) }} {{ end }}
                <span>{{ .Name }}</span>
              </a>
              {{ end }}
            </div>
          </div>
          {{ else }} {{ $isActive := eq $currentPage.RelPermalink $menuURL }}
          <a
            href="{{ $menuURL }}"
            class="nav-link {{ if $isActive }}
                  nav-active-indicator border-2 border-primary bg-primary/10 text-primary
                {{ else }}
                  text-muted-foreground border-2 border-muted-foreground hover:text-primary hover:bg-primary/10
                {{ end }} focus:ring-primary/20 relative flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-all duration-300 ease-out hover:-translate-y-0.5 hover:scale-105 focus:ring-2 focus:outline-none ">
            {{ if .Params.icon }} {{ partial ".*.gohtml" (dict "name"
            .Params.icon "size" "md" "ariaLabel" .Name) }} {{ end }}
            <span>{{ .Name }}</span>
          </a>
          {{ end }} {{ end }}
        </div>
      </nav>

      <!-- 右侧：桌面端控制区域 -->
      <div class="flex items-center space-x-2">
        <!-- 页面宽度调整（仅桌面端） -->
        {{ partial ".*.gohtml" . }}

        <!-- 语言切换按钮 -->
        {{ partial ".*.gohtml" . }}

        <!-- 主题风格切换按钮 -->
        {{ partial ".*.gohtml" . }}

        <!-- 明暗模式切换按钮 -->
        {{ partial ".*.gohtml" . }}
      </div>
    </div>

    <!-- 移动端布局 -->
    <div class="flex w-full items-center justify-between md:hidden">
      <!-- 左侧：移动端菜单按钮 -->
      {{ partial ".*.gohtml" . }}

      <!-- 右侧：移动端控制区域 -->
      <div class="flex items-center space-x-2">
        <!-- 语言切换按钮 -->
        {{ partial ".*.gohtml" . }}

        <!-- 主题风格切换按钮 -->
        {{ partial ".*.gohtml" . }}

        <!-- 明暗模式切换按钮 -->
        {{ partial ".*.gohtml" . }}
      </div>
    </div>
  </div>

  <!-- 移动端锚定式宽导航面板（card 下方） -->
  {{ partial ".*.gohtml" . }}
</header>
